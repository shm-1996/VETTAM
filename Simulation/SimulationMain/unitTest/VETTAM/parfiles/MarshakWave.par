
# Simulation parameters:	
sim_rhoambient          =  1.e-20
sim_erambient           =  0.0
sim_tempAmbient         =  0.0
sim_eddvalue            =  0.33
sim_epsilon             =  0.1
# Corresponding to k_BT_inc = 4.68e-13 eV
sim_finc                =  7.494e9
#Ideally make this consistent with above. If not simulation_initblock should do that for you.
#Finc = aR*c*T**4/4
rt_boundary_T   = 3390.5878250928063
enableGCMaskedFill = .true.

xmin                           = 0.0
xmax                           = 0.5
#ymin                           = 0.0
#ymax                           = 0.5
#zmin                           = 0.0
#zmax                           = 0.5

geometry = "cartesian"
xl_boundary_type               = "periodic" 
xr_boundary_type               = "periodic" 
yl_boundary_type               = "periodic" 
yr_boundary_type               = "periodic" 
zl_boundary_type               = "periodic" 
zr_boundary_type               = "periodic" 

# Sink particles

useParticles              = .false.
useSinkParticles          = .false.

# Refinement parameters:

lrefine_max           = 1
lrefine_min           = 1
refine_var_1          = "none"
refine_var_thresh     = "dens"
refineOnJeansLength   = .false.
jeans_ncells_ref      = 16.0
jeans_ncells_deref    = 32.0
refineOnSinkParticles = .false.

nblockx               = 128

bb_init_restart      = .false.
restart              = .false.
checkpointFileNumber = 0
plotFileNumber       = 0
particleFileNumber   = 0
movie_dump_num       = 0

basenm      = "Marshak_"
log_file    = "Marshak.log"
run_comment = "Marshak"

tmax   = 8.33e-10
nend   = 100000
wall_clock_checkpoint = 21000.0
wall_clock_time_limit = 17100.0 # 171000.0

dtinit = 1.e-10
dtmin = 1.e-15
dtmax  = 5.0e99
checkpointFileIntervalStep     = 0
checkpointFileIntervalTime     = 8.33e-11
plotFileIntervalStep           = 0
plotFileIntervalTime           = 8.33e-13 # 1.0e10
particleFileIntervalStep       = 1
particleFileIntervalTime       = 1e99 # 1.0e10

plot_var_1  = "dens"
plot_var_2  = "temp"
plot_var_3  = "xxed"
plot_var_4  = "erad"
plot_var_5  = "mohx"
plot_var_6 =  "eint"
enableMaskedGCFill = .true.
# ==========================================
#
# Radiation from 3DRT hybrid characteristics
#


# background radiation field, mean intensity [erg s^-1 cm^-2]
# J = sigma_SB/pi T^4
# J = 1.8048171e-05 * T^4 = 0.18048171 (T/10 K)^4

# number of sweep angles

# nside Healpix parameter, if > 0 use Healpix tesselation

# if rt_healpix_nSide==0 use one ray only with the following direction

# acclerated Lambda iteration

# order of integration for source function

# not implemented yet

# cooling & heating from radiation
useHydro              = .false.
useRadTrans           = .true.
rt_T_min              = 0.0
rt_compute_Dt         = .true.
rt_Dt_type            = 1
rt_dtFactor           = 5.0
rt_rtol               = 1.e-8
rt_abstol             = 1.e-20
rt_dtol               = 1.e10
rt_maxits             = 10000
rt_minits             = 10
rt_update_hydro       = .true.
#Hydro update type for cooling
# 1: LTE Temp update only, 2: NR Energy update only, 3: NR Energy+Rad Pressure update
rt_hydro_type         = 2
rt_temp_type          = 5
rt_picard_rtol        = 1.e-3
rt_hlle_correction    = .true.
#Radiation BC
# 1: reflecting, 2: outflow, 3: Dirichlet, 4: Periodic 5: Vacuum 6: Marshak
xl_rad_BC             = 6
xr_rad_BC             = 1
yl_rad_BC             = 4
yr_rad_BC             = 4
zl_rad_BC             = 4
zr_rad_BC             = 4

#Opacity type: Accepted values - "Fixed", "Semenov"
# Single grey band; the default of 3 would leave TAUP holding the last
# band's opacity.
rt_freqbands          = 1
rt_band1              = "IR"

dust_opacity_ir       =  "Fixed"
#Fixed opacity value
dust_iropac_value     =  4.e21

#Etens type
rt_etens        = "edd"

# EosMode               = dens_temp

# 
# End of Radiation parameters
# ==========================================


# Hydrodynamics
eos_singleSpeciesA = 0.6
gamma = 1.666666666667
eintSwitch = 0 # set this to zero
cfl = 0.5

use_avisc             = .false.
cvisc                 = 0.1
conservation is not enforced during refinement
#UnitSystem            = "CGS"

small      =  1.0e-99
smlrho     =  1.0e-99 # 1.4182454e-23
smallp     =  1.0E-99
smalle     =  1.0e-99
smallt     =  1.0e-99
smallu     =  1.0E-99
smallx     =  1.0E-99

# === Gravity ===

useGravity         = .false.
grav_boundary_type = "isolated"
mg_maxResidualNorm = 1.0e-6
mg_printNorm       = .false.

# === Tree grav. solver ===

gr_bhIlist        = 1
gr_bhTreeLimAngle = 0.8

# Polytrope

usePolytrope     = .false.
PolytropeDens1   = 1e-99 # 1.4182454e-19
PolytropeDens2   = 2.50e-16  # Masunaga & Inutsuka (2000)
PolytropeDens3   = 3.84e-13
PolytropeDens4   = 3.84e-8
PolytropeDens5   = 3.84e-3
PolytropeGamma1  = 1.0
PolytropeGamma2  = 1.1
PolytropeGamma3  = 1.4
PolytropeGamma4  = 1.1
PolytropeGamma5  = 1.666666
PolytropeKonst   = 4.0e8

# rt_cv_alpha (c_v = alpha*T^3, the Su & Olson material) is not set here:
# Simulation_initBlock derives it as 4*a_r/sim_epsilon and assigns it, the same
# way it reconciles rt_boundary_T with sim_finc.
